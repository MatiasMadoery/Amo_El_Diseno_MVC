@model ExpenseDetailsViewModel

@{
    ViewData["Title"] = "Detalle";
}


<link rel="stylesheet" href="/css/customers.css" />

<h1>DETALLE</h1>
<hr />
<div>
    <dl class="row gx-5 gy-3">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Expense.TransactionDate)
        </dt>
        <dd class="col-sm-10">
            @Model.Expense.TransactionDate.ToShortDateString()
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Expense.AccountingAccount)
        </dt>
        <dd class="col-sm-10">
            @Model.Expense.AccountingAccount
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Expense.Concept)
        </dt>
        <dd class="col-sm-10">
            @Model.Expense.Concept
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Expense.Amount)
        </dt>
        <dd class="col-sm-10">
            @Model.Expense.Amount?.ToString("C") 
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Expense.Recipient)
        </dt>
        <dd class="col-sm-10">
            @Model.Expense.Recipient
        </dd>
        <dt class="col-sm-2">Comprobante de Pago</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Expense.PaymentReceiptPDFPath))
            {
                <a href="@Model.Expense.PaymentReceiptPDFPath" target="_blank">Ver PDF</a>
            }
            else if (!string.IsNullOrEmpty(Model.Expense.PaymentReceiptImagePath))
            {
                <img src="@Model.Expense.PaymentReceiptImagePath" alt="Imagen del Comprobante" class="img-thumbnail" />
            }
            else
            {
                <p>No hay comprobante de pago cargado.</p>
            }
        </dd>
    </dl>
</div>
<br />
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Expense.Id" class="btn-azul">Editar</a> |
    <a asp-action="Index" class="volver-link">Volver a la lista</a>
</div>