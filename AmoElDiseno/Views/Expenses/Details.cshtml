@model ExpenseDetailsViewModel

@{
    ViewData["Title"] = "Expense Details";
}

<h1>Expense Details</h1>
<hr />

<link rel="stylesheet" href="/css/customers.css" />

<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Expense.TransactionDate)
        </dt>
        <dd class="col-sm-10">
            @Model.Expense.TransactionDate.ToShortDateString()
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Expense.AccountingAccount)
        </dt>
        <dd class="col-sm-10">
            @Model.Expense.AccountingAccount
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Expense.Concept)
        </dt>
        <dd class="col-sm-10">
            @Model.Expense.Concept
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Expense.Amount)
        </dt>
        <dd class="col-sm-10">
            @Model.Expense.Amount?.ToString("C")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Expense.Recipient)
        </dt>
        <dd class="col-sm-10">
            @Model.Expense.Recipient
        </dd>

        <dt class="col-sm-2">
            Payment Receipt
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrWhiteSpace(Model.Expense.PaymentReceiptImagePath))
            {
                <img src="@Url.Content(Model.Expense.PaymentReceiptImagePath)" alt="Payment Receipt" class="img-thumbnail" style="max-width:300px;" />
            }
            else
            {
                <p>No payment receipt uploaded.</p>
            }
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Expense.Id" class="btn btn-warning">Editar</a> 
    |
    <a asp-action="Index" class="btn btn-secondary">Volver ala lista</a>
</div>



