@model AmoElDiseno.Models.Expense

@{
    ViewData["Title"] = "Delete";
}

<link rel="stylesheet" href="/css/customers.css">

<h1>ELIMINAR</h1>
<hr />
<div>       
    <dl class="row gx-2 gy-3">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TransactionDate)
        </dt>
        <dd class = "col-sm-10">
            @Model.TransactionDate.ToShortDateString()
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AccountingAccount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AccountingAccount)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Concept)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Concept)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Amount)
        </dt>
        <dd class = "col-sm-10">
           $ @Html.DisplayFor(model => model.Amount)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Recipient)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Recipient)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PaymentReceiptImagePath)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PaymentReceiptImagePath)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn-rojo" />
    </form>
    <a asp-action="Index" class="volver-link">Volver a la lista</a>
</div>
