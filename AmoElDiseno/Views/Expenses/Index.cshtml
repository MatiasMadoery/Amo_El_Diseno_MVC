@model Pager<AmoElDiseno.Models.Expense>

@{
    ViewData["Title"] = "Egresos";
}

<link rel="stylesheet" href="/css/customers.css">

<h1>EGRESOS</h1>

<hr />

<form method="get" asp-action="Index" class="mb-4">
    <div class="row">       
        <div class="col-12 col-md-4 mb-2 mb-md-0">
            <input type="text" name="searchString" id="searchBox"
                   placeholder="Buscar por receptor o concepto..."
                   class="form-control"
                   value="@ViewContext.HttpContext.Request.Query["searchString"]"
                   autocomplete="off" />
        </div>       
        <div class="col-12 col-md-4 mb-2 mb-md-0">
            <select name="searchAccount" class="form-control">
                <option value="">Filtrar por cuenta</option>
                @foreach (var account in Enum.GetValues(typeof(AccountingAccount)))
                {
                    var accountStr = account.ToString();
                    if (accountStr == (ViewData["searchAccount"]?.ToString() ?? ""))
                    {
                        <option value="@accountStr" selected="selected">@accountStr</option>
                    }
                    else
                    {
                        <option value="@accountStr">@accountStr</option>
                    }
                }
            </select>
        </div>
        <div class="d-flex flex-wrap justify-content-start gap-2">
            <div class="col-12 col-md-2 d-flex align-items-center">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
            <div class="col-12 col-md-2 d-flex align-items-center">
                <a href="@Url.Action("Index")" class="btn btn-secondary w-100">Limpiar</a>
            </div>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn-verde">Crear Nuevo Egreso</a>
</p>

<div class="table-responsive">
    @if (!Model.Elements.Any())
    {
        <div class="alert alert-warning" role="alert">
            No se encontraron resultados.
        </div>
    }
    else
    {
        <table class="table table-striped">
            <thead class="text-center align-middle">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Elements.First().TransactionDate)</th>
                    <th>@Html.DisplayNameFor(model => model.Elements.First().AccountingAccount)</th>
                    <th>@Html.DisplayNameFor(model => model.Elements.First().Recipient)</th>
                    <th>@Html.DisplayNameFor(model => model.Elements.First().Concept)</th>
                    <th>@Html.DisplayNameFor(model => model.Elements.First().Amount)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Elements)
                {
                    <tr>
                        <td>@item.TransactionDate.ToShortDateString()</td>
                        <td>@Html.DisplayFor(modelItem => item.AccountingAccount)</td>
                        <td>@Html.DisplayFor(modelItem => item.Recipient)</td>
                        <td>@Html.DisplayFor(modelItem => item.Concept)</td>
                        <td>@(item.Amount?.ToString("N2") ?? "0,00")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-3 justify-content-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-azul">Detalles</a> 
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-amarillo">Editar</a> 
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-rojo">Eliminar</a>
                            </div>                            
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>


<div class="mt-3">
    @if (Model.PreviousPage)
    {
        <a asp-action="Index"
           asp-route-page="@(Model.CurrentPage - 1)"
           asp-route-searchString="@(ViewData["searchString"] ?? "")"
           asp-route-searchAccount="@(ViewData["searchAccount"] ?? "")"
           class="btn btn-secondary btn-sm">Anterior</a>
    }
    Página @Model.CurrentPage de @Model.TotalPages
    @if (Model.NextPage)
    {
        <a asp-action="Index"
           asp-route-page="@(Model.CurrentPage + 1)"
           asp-route-searchString="@(ViewData["searchString"] ?? "")"
           asp-route-searchAccount="@(ViewData["searchAccount"] ?? "")"
           class="btn btn-secondary btn-sm">Siguiente</a>
    }
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}