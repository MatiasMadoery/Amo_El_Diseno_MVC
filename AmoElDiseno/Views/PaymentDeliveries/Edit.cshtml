@model AmoElDiseno.Models.PaymentDelivery

@{
    ViewData["Title"] = "Editar";
    var orderId = ViewData["OrderId"];
}

<link rel="stylesheet" href="/css/customers.css">

<h1>EDITAR</h1>
<hr />
<div class="row">
    <div>
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="OrderId" />

            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" type="date"/>
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Amount" class="control-label"></label>
                <input asp-for="Amount" class="form-control" type="number"/>
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <button type="submit" class="btn-verde">Guardar</button>
        </form>
    </div>
</div>

<div>
    <a asp-action="Details" asp-controller="Orders" asp-route-id="@orderId" class="volver-link">Volver a la edicion del pedido</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
