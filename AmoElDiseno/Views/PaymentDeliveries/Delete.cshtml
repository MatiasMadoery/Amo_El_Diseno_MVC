@model AmoElDiseno.Models.PaymentDelivery

@{
    ViewData["Title"] = "Eliminar";
    var orderId = ViewData["OrderId"];
}

<link rel="stylesheet" href="/css/customers.css">

<h1>ELIMINAR</h1>

<div>
    <h4>Pago</h4>
    <hr />
    <dl class="row gx-2 gy-3">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Order)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Order!.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Date)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Amount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Amount)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="orderId" value="@orderId" />
        <input type="submit" value="Eliminar" class="btn-rojo" />        
    </form>
    <a asp-action="Details" asp-controller="Orders" asp-route-id="@orderId" class="volver-link">Volver a la lista</a>
</div>
