@model Pager<AmoElDiseno.Models.Order>

@{
    ViewData["Title"] = "Pedidos";
}

<link rel="stylesheet" href="~/css/orders.css">

<h2>Pedidos</h2>

<!-- Formulario de búsqueda -->
<form method="get" id="filter-form" class="mb-4">
    <div class="row">
        <div class="col-8 col-sm-8 col-md-4">
            <input type="text" name="searchString" class="form-control"
                   placeholder="Buscar pedido..." value="@ViewData["searchString"]" />
        </div>
        <div class="col-1 col-md-4">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </div>
</form>

<hr />

<p>
    <a asp-action="Create" class="btn-verde">Crear Nuevo Pedido</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Número de Pedido</th>
            <th>Cliente</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Fecha de Entrega</th>
            <th>Saldo Pendiente</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Elements)  
        {
            string rowClass = "";
            if (order.Date.HasValue)
            {
                double dayPassed = (DateTime.Now - order.Date.Value).TotalDays;
                if (dayPassed > 21)
                {
                    rowClass = "redResalt";
                }
                else if (dayPassed > 14 && dayPassed < 22)
                {
                    rowClass = "orangeResalt";
                }
            }
            <tr class="@rowClass">
                <td>@order.OrderNumber</td>
                <td>@order.Customer?.Name</td>
                <td>@order.Date?.ToShortDateString()</td>
                <td>@order.Status</td>
                <td>@order.DeliveryDate?.ToShortDateString()</td>
                <td>@order.PendingBalance?.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.Id" class="btn-azul">Detalles</a> |
                    <a asp-action="Edit" asp-route-id="@order.Id" class="btn-amarillo">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@order.Id" class="btn-rojo">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Controles de paginación -->
<div class="mt-3">
    @if (Model.PreviousPage)
    {
        <a asp-action="Index"
           asp-route-page="@(Model.CurrentPage - 1)"
           asp-route-searchString="@ViewData["searchString"]"
           class="btn btn-secondary btn-sm">Anterior</a>
    }

    Página @Model.CurrentPage de @Model.TotalPages

    @if (Model.NextPage)
    {
        <a asp-action="Index"
           asp-route-page="@(Model.CurrentPage + 1)"
           asp-route-searchString="@ViewData["searchString"]"
           class="btn btn-secondary btn-sm">Siguiente</a>
    }
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


