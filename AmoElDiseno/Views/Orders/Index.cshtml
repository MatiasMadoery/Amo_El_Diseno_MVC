@model IEnumerable<Order>

<h2>Pedidos</h2>
<hr />
<a asp-action="Create" class="btn-verde">Crear Nuevo Pedido</a>
<link rel="stylesheet" href="~/css/orders.css">
<table class="table">
    <thead>
        <tr>
            <th>Número de Pedido</th>
            <th>Cliente</th>
            <th>Fecha</th>
            <th>Fecha de Entrega</th>
            <th>Estado</th>
            <th>Saldo Pendiente</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            string rowClass = "";

            if(order.Status != OrderStatus.EntregaPendiente && order.Status != OrderStatus.Entregado)
            {
                if (order.Date.HasValue)
                {
                    double dayPassed = (DateTime.Now - order.Date.Value).TotalDays;

                    if (dayPassed > 21)
                    {
                        rowClass = "redResalt";
                    }
                    if (dayPassed > 14 && dayPassed < 22)
                    {
                        rowClass = "orangeResalt";
                    }
                }
            }


            <tr class="@rowClass">
                <td>@order.OrderNumber</td>
                <td>@order.Customer?.Name</td>
                <td>@order.Date?.ToShortDateString()</td>
                <td>@order.DeliveryDate?.ToShortDateString()</td>
                <td>@order.Status</td>
                <td>@order.PendingBalance?.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.Id" class="btn-azul">Detalles</a> |
                    <a asp-action="Edit" asp-route-id="@order.Id" class="btn-amarillo">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@order.Id" class="btn-rojo">Eliminar</a>

                </td>
            </tr>
        }
    </tbody>
</table>
