@model IEnumerable<Order>

<h2>Pedidos</h2>
<a asp-action="Create" class="btn btn-primary">Crear Nuevo Pedido</a>
<table class="table">
    <thead>
        <tr>
            <th>Número de Pedido</th>
            <th>Cliente</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Monto Total</th>
            <th>Saldo Pendiente</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderNumber</td>
                <td>@order.Customer?.Name</td>
                <td>@order.Date?.ToShortDateString()</td>
                <td>@order.Status</td>
                <td>@order.Total?.ToString("C")</td>
                <td>@order.PendingBalance?.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.Id">Detalles</a> |
                    <a asp-action="Edit" asp-route-id="@order.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@order.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
