@model Pager<AmoElDiseno.Models.Order>

@{
    ViewData["Title"] = "Pedidos";
}

<link rel="stylesheet" href="~/css/orders.css">

<h1>PEDIDOS</h1>

<hr />

<form method="get" asp-action="Index">
    <div class="row">
        <div class="col-md-4">
            <label for="customerSearch">Buscar Cliente:</label>
            <select id="customerSearch" class="form-control select2" name="customerId" data-url="@Url.Action("GetCustomers")">
                <option value="">Seleccione un Cliente...</option>
            </select>
        </div>
        <div class="col-md-2">
            <label for="startDate">Fecha Inicio:</label>
            <input type="date" name="startDate" class="form-control" value="@Context.Request.Query["startDate"]" />
        </div>
        <div class="col-md-2">
            <label for="endDate">Fecha Fin:</label>
            <input type="date" name="endDate" class="form-control" value="@Context.Request.Query["endDate"]" />
        </div>
        <div class="col-md-2">
            <label>&nbsp;</label>
            <button type="submit" class="btn btn-primary form-control">Filtrar</button>
        </div>
        <div class="col-md-2">
            <label>&nbsp;</label>
            <a href="@Url.Action("Index")" class="btn btn-secondary form-control">Limpiar</a>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn-verde">Crear Nuevo Pedido</a>
</p>
<div class="table-responsive">
    <table class="table table-striped">
        <thead class="text-center align-middle">
            <tr>
                <th>Número de Pedido</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Fecha de Entrega</th>
                <th>Saldo Pendiente</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Elements)
            {
                string rowClass = "";
                if (order.Date.HasValue)
                {
                    double dayPassed = (DateTime.Now - order.Date.Value).TotalDays;
                    if (dayPassed > 21)
                    {
                        rowClass = "redResalt";
                    }
                    else if (dayPassed > 14 && dayPassed < 22)
                    {
                        rowClass = "orangeResalt";
                    }
                }
                <tr class="@rowClass">
                    <td>@order.OrderNumber</td>
                    <td>@order.Customer?.FullName</td>
                    <td>@order.Date?.ToShortDateString()</td>
                    <td>@order.Status</td>
                    <td>@order.DeliveryDate?.ToShortDateString()</td>
                    <td>@order.PendingBalance?.ToString("C")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-3 justify-content-center">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn-azul">Detalles</a> 
                            <a asp-action="Edit" asp-route-id="@order.Id" class="btn-amarillo">Editar</a> 
                            <a asp-action="Delete" asp-route-id="@order.Id" class="btn-rojo">Eliminar</a>
                        </div>                      
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- Controles de paginación -->
<div class="mt-3">
    @if (Model.PreviousPage)
    {
        <a asp-action="Index"
           asp-route-page="@(Model.CurrentPage - 1)"
           asp-route-searchString="@ViewData["searchString"]"
           class="btn btn-secondary btn-sm">Anterior</a>
    }

    Página @Model.CurrentPage de @Model.TotalPages

    @if (Model.NextPage)
    {
        <a asp-action="Index"
           asp-route-page="@(Model.CurrentPage + 1)"
           asp-route-searchString="@ViewData["searchString"]"
           class="btn btn-secondary btn-sm">Siguiente</a>
    }
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@section Scripts{
    <link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#customerSearch').select2({
                ajax: {
                    url: "/Orders/GetCustomers",
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { term: params.term };
                    },
                    processResults: function (data) {
                        return {
                            results: data.map(function (customer) {
                                return { id: customer.id, text: customer.text };
                            })
                        };
                    },
                    cache: true
                },
                minimumInputLength: 1,
                placeholder: "Buscar cliente...",
                allowClear: true,
                language: {
                    inputTooShort: function () {
                        return "Por favor, ingrese 1 o más caracteres";
                    },
                    searching: function () {
                        return "Buscando...";
                    },
                    noResults: function () {
                        return "No se encontraron resultados";
                    }
                }
            });
        });
    </script>
}