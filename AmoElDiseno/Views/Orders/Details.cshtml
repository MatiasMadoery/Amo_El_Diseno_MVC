@model OrderDetailsViewModel

<h2>Detalles del Pedido</h2>
<hr />

<link rel="stylesheet" href="/css/orders.css">

<div>
    <h4>Pedido #@Model.Order!.OrderNumber</h4>
    <dl class="row">
        <dt class="col-sm-2">
            Número de Pedido
        </dt>
        <dd class="col-sm-10">
            @Model.Order.OrderNumber
        </dd>
        <dt class="col-sm-2">
            Cliente
        </dt>
        <dd class="col-sm-10">
            @Model.Order.Customer?.Name
        </dd>
        <dt class="col-sm-2">
            Fecha
        </dt>
        <dd class="col-sm-10">
            @Model.Order.Date?.ToShortDateString()
        </dd>
        <dt class="col-sm-2">
            Detalles
        </dt>
        <dd class="col-sm-10">
            @Model.Order.Details
        </dd>
        <dt class="col-sm-2">
            Estado
        </dt>
        <dd class="col-sm-10">
            @Model.Order.Status
        </dd>
        <dt class="col-sm-2">
            Monto Total
        </dt>
        <dd class="col-sm-10">
            @Model.Order.Total?.ToString("C")
        </dd>
        <dt class="col-sm-2">
            Saldo Pendiente
        </dt>
        <dd class="col-sm-10">
            @Model.Order.PendingBalance?.ToString("C")
        </dd>
    </dl>
</div>

<h3>Entregas de Pago</h3>

<table class="table">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var payment in Model.Order.PaymentDeliveries!)
        {
            <tr>
                <td>@payment.Date.ToShortDateString()</td>
                <td>@payment.Amount?.ToString("C")</td>
                <td>
                    <a 
                        asp-action="Edit" 
                        asp-controller="PaymentDeliveries" 
                        asp-route-id="@payment.Id" 
                        asp-route-orderId="@Model.Order.Id"
                        class="btn-amarillo">
                        Editar
                    </a> |
                    <a 
                        asp-action="Delete"
                        asp-controller="PaymentDeliveries" 
                        asp-route-id="@payment.Id" 
                        asp-route-OrderId ="@Model.Order.Id"
                        class="btn-rojo">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<h4>Agregar Pago</h4>

<form asp-action="AddPaymentDelivery" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Order!.Id" />

    <div class="form-group">
        <label for="Date">Fecha</label>
        <input asp-for="NewPaymentDelivery.Date" class="form-control" type="date" />
        <span asp-validation-for="NewPaymentDelivery.Date" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Amount">Monto</label>
        <input asp-for="NewPaymentDelivery.Amount" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="NewPaymentDelivery.Amount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn-verde">Agregar Pago</button>
</form>

<a asp-action="Index" class="volver-link">Volver a la lista</a>