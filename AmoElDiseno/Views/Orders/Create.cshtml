@model Order

<h2>Crear Pedido</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Número de Pedido</label>
        <input asp-for="OrderNumber" class="form-control" />
    </div>
    <div class="form-group">
        <label>Cliente</label>
        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-control"></select>
    </div>
    <div class="form-group">
        <label>Fecha</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label>Detalles</label>
        <textarea asp-for="Details" class="form-control"></textarea>
    </div>
    <div class="form-group">
        <label>Estado</label>
        <select asp-for="Status" class="form-control">
            @foreach (var status in Enum.GetValues(typeof(OrderStatus)))
            {
                if (Model.Status == (OrderStatus)status)
                {
                    <option value="@status" selected>@status</option>
                }
                else
                {
                    <option value="@status">@status</option>
                }
            }
        </select>
    </div>
    <div class="form-group">
        <label>Monto Total</label>
        <input asp-for="Total" type="number" step="0.01" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Crear Pedido</button>
</form>

<a asp-action="Index">Volver a la lista</a>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
