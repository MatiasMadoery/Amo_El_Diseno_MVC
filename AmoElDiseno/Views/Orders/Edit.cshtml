@model AmoElDiseno.Models.Order

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar</h1>
<hr />
<link rel="stylesheet" href="/css/orders.css">
<div class="row">
    <div> 
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="OrderNumber" class="control-label"></label>
                <input asp-for="OrderNumber" class="form-control" />
                <span asp-validation-for="OrderNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CustomerId" class="control-label"></label>
                <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.CustomerId"></select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Details" class="control-label"></label>
                <input asp-for="Details" class="form-control" />
                <span asp-validation-for="Details" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Estado</label>
                <select asp-for="Status" class="form-control">
                    @foreach (var status in Enum.GetValues(typeof(OrderStatus)))
                    {
                        if (Model.Status == (OrderStatus)status)
                        {
                            <option value="@status" selected>@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Monto Total</label>
                <input asp-for="Total" type="number" step="0.1" min="0" class="form-control" />
            </div>
            <button type="submit" class="btn-verde">Guardar</button>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="volver-link">Volver a la lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
