@model BalanceViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Balances";
}

<h1>BALANCES</h1>
<hr />
<form asp-action="Balances" method="get" class="mb-4">
    <div class="row g-3">      
        <div class="col-12 col-md-3">
            <label for="periodType" class="form-label">Periodo:</label>
            <select name="periodType" id="periodType" class="form-control">
                @foreach (var option in new[] {
                new { Value = "Mensual", Text = "Mensual", EnumValue = PeriodType.Mensual },
                new { Value = "Semestral", Text = "Semestral", EnumValue = PeriodType.Semestral },
                new { Value = "Anual", Text = "Anual", EnumValue = PeriodType.Anual }
                })
                {
                    if (option.EnumValue == Model.SelectedPeriodType)
                    {
                        <option value="@option.Value" selected="selected">@option.Text</option>
                    }
                    else
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                }
            </select>
        </div>        
        <div class="col-12 col-md-3">
            <label for="year" class="form-label">Año:</label>
            <input type="number" name="year" id="year" class="form-control" value="@Model.SelectedYear" />
        </div>        
        @if (Model.SelectedPeriodType == PeriodType.Mensual)
        {
            <div class="col-12 col-md-3">
                <label for="month" class="form-label">Mes:</label>
                <input type="number" name="month" id="month" class="form-control" value="@(Model.SelectedMonth ?? DateTime.Now.Month)" min="1" max="12" />
            </div>
        }
        else if (Model.SelectedPeriodType == PeriodType.Semestral)
        {
            <div class="col-12 col-md-3">
                <label for="semester" class="form-label">Semestre:</label>
                <select name="semester" id="semester" class="form-control">
                    @if (Model.SelectedSemester == 1)
                    {
                        <option value="1" selected="selected">Primer semestre</option>
                        <option value="2">Segundo semestre</option>
                    }
                    else if (Model.SelectedSemester == 2)
                    {
                        <option value="1">Primer semestre</option>
                        <option value="2" selected="selected">Segundo semestre</option>
                    }
                    else
                    {
                        <option value="1">Primer semestre</option>
                        <option value="2">Segundo semestre</option>
                    }
                </select>
            </div>
        }        
        <div class="col-12 col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
        </div>
    </div>
</form>

<hr />

<h2 class="text-center text-success mb-4">INGRESOS</h2>
<table class="table table-bordered table-hover table-striped text-center align-middle">
    <thead class="table-success">
        <tr>
            <th>Fecha</th>
            <th>Número de Pedido</th>
            <th>Importe</th>
            <th>Detalle</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var income in Model.Incomes)
        {
            <tr>
                <td>@income.Date?.ToShortDateString()</td>
                <td>@income.Order?.OrderNumber</td>
                <td>@income.Amount?.ToString("C", CultureInfo.CurrentCulture)</td>
            </tr>
        }
    </tbody>
</table>
<br />
<h2 class="text-center text-danger mb-4">EGRESOS</h2>
<table class="table table-bordered table-hover table-striped text-center align-middle">
    <thead class="table-danger">
        <tr>
            <th>Fecha</th>
            <th>Cuenta</th>
            <th>Concepto</th>
            <th>Importe</th>
            <th>Receptor</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var expense in Model.Expenses)
        {
            <tr>
                <td>@expense.TransactionDate.ToShortDateString()</td>
                <td>@expense.AccountingAccount</td>
                <td>@expense.Concept</td>
                <td>@expense.Amount?.ToString("C", CultureInfo.CurrentCulture)</td>
                <td>@expense.Recipient</td>
            </tr>
        }
    </tbody>
</table>
<br />
<hr />
<div class="bg-light p-4 rounded shadow">
    <h3 class="text-center text-dark">RESUMEN DE CUENTA</h3>
    <br />
    <p><strong>Total Ingresos:</strong> <span class="text-success fw-bold">@Model.TotalIncome.ToString("C", CultureInfo.CurrentCulture)</span></p>
    <p><strong>Total Egresos:</strong> <span class="text-danger fw-bold">@Model.TotalExpense.ToString("C", CultureInfo.CurrentCulture)</span></p>
    <p style="font-size: 1.5rem">
        <strong>Saldo Neto:</strong>
        <span class="@(Model.NetBalance >= 0 ? "text-success fw-bold" : "text-danger fw-bold")">
            @Model.NetBalance.ToString("C", CultureInfo.CurrentCulture)
        </span>
    </p>
</div>

