@model Pager<AmoElDiseno.Models.Customer>

@{
    ViewData["Title"] = "Clientes";
}

<link rel="stylesheet" href="/css/customers.css">

<h1>CLIENTES</h1>

<hr />

<form id="searchForm" method="get" asp-action="Index">
    <label for="customerSearch">Buscar Cliente:</label>
    <select id="customerSearch" class="form-control select2" data-url="@Url.Action("SearchCustomers")">
        <option value="">Seleccione un Cliente...</option>
    </select>

    <input type="hidden" name="searchString" id="hiddenSearchInput" value="@Context.Request.Query["searchString"]" />

    <button type="submit" class="btn btn-primary mt-2">Buscar</button>
</form>

<p>
    <a asp-action="Create" class="btn-verde">Crear Nuevo Cliente</a>
</p>

@if (!Model.Elements.Any())
{
    <div class="alert alert-warning" role="alert">
        No se encontraron resultados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="text-center align-middle">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Elements.First().Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Elements.First().LastName)</th>
                    <th>@Html.DisplayNameFor(model => model.Elements.First().Phone)</th>                    
                    <th>
                        Acciones
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Elements)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Phone)</td>                        
                        <td>
                            <div class="d-flex flex-wrap gap-3 justify-content-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-azul">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-amarillo">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-rojo">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

}
<div class="mt-3">
    @if (Model.PreviousPage)
    {
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchString="@ViewData["searchString"]" class="btn btn-secondary btn-sm">Anterior</a>
    }

    Página @Model.CurrentPage de @Model.TotalPages

    @if (Model.NextPage)
    {
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchString="@ViewData["searchString"]" class="btn btn-secondary btn-sm">Siguiente</a>
    }
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            var searchInput = $('#hiddenSearchInput').val();

            $('#customerSearch').select2({
                ajax: {
                    url: $('#customerSearch').data('url'),
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { term: params.term };
                    },
                    processResults: function (data) {
                        return {
                            results: data.map(function (customer) {
                                return { id: customer.text, text: customer.text }; // Enviar nombre completo
                            })
                        };
                    },
                    cache: true
                },
                minimumInputLength: 1,
                placeholder: "Buscar cliente...",
                allowClear: true,
                language: {
                    inputTooShort: function () {
                        return "Por favor, ingrese 1 o más caracteres";
                    },
                    searching: function () {
                        return "Buscando...";
                    },
                    noResults: function () {
                        return "No se encontraron resultados";
                    }
                }
            });

            // Restaurar el valor anterior si hay una búsqueda guardada
            if (searchInput) {
                var newOption = new Option(searchInput, searchInput, true, true);
                $('#customerSearch').append(newOption).trigger('change');
            }

            // Guardar el texto seleccionado en el input oculto antes de enviar
            $('#customerSearch').on('select2:select', function (e) {
                $('#hiddenSearchInput').val(e.params.data.text);
            });

            // Limpiar el input oculto si el usuario borra la selección
            $('#customerSearch').on('select2:clear', function () {
                $('#hiddenSearchInput').val('');
            });
        });
    </script>
}

