@model IEnumerable<AmoElDiseno.Models.Customer>

@{
    ViewData["Title"] = "Index";
}

<h1>Clientes</h1>
<hr />
<link rel="stylesheet" href="/css/customers.css">
<p>
    <a asp-action="Create" class="btn-verde">Crear Nuevo Cliente</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                Acciones
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-azul">Detalles</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-amarillo">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-rojo">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
