@model Pager<AmoElDiseno.Models.Customer>

@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="/css/customers.css">

<h1>Clientes</h1>

<!-- Search form -->

<form method="get" asp-action="Index">
    <input type="text" name="searchString" id="searchBox"
           placeholder="Buscar por nombre o apellido..."
           class="form-control" value="@Context.Request.Query["searchString"]" autocomplete="off" />
    <ul id="suggestions" class="list-group" style="display: none; position: absolute; z-index: 1000;"></ul>
    <button type="submit" class="btn btn-primary mt-2">Buscar</button>
</form>

<hr />

<p>
    <a asp-action="Create" class="btn-verde">Crear Nuevo Cliente</a>
</p>

@if (!Model.Elements.Any())
{
    <div class="alert alert-warning" role="alert">
        No se encontraron resultados.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Elements.First().Name)</th>
                <th>@Html.DisplayNameFor(model => model.Elements.First().LastName)</th>
                <th>@Html.DisplayNameFor(model => model.Elements.First().Phone)</th>
                <th>@Html.DisplayNameFor(model => model.Elements.First().Email)</th>
                <th>
                    Acciones
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Elements)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                    <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-azul">Detalles</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-amarillo">Editar</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-rojo">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
<div class="mt-3">
    @if (Model.PreviousPage)
    {
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchString="@ViewData["searchString"]" class="btn btn-secondary btn-sm">Anterior</a>
    }

    Página @Model.CurrentPage de @Model.TotalPages

    @if (Model.NextPage)
    {
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchString="@ViewData["searchString"]" class="btn btn-secondary btn-sm">Siguiente</a>
    }
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#searchBox").on("input", function () {
                var query = $(this).val();

                if (query.length >= 3) {
                    $.ajax({
                        url: '@Url.Action("SearchAutocomplete")',
                        data: { term: query },
                        success: function (data) {
                            var suggestions = $("#suggestions");
                            suggestions.empty();

                            if (data.length > 0) {
                                suggestions.show();
                                $.each(data, function (index, item) {
                                    suggestions.append('<li class="list-group-item">' + item + '</li>');
                                });

                                var inputOffset = $("#searchBox").offset().top;
                                var inputHeight = $("#searchBox").outerHeight();
                                var suggestionsHeight = suggestions.outerHeight();
                                var windowHeight = $(window).height();

                                var spaceBelow = windowHeight - (inputOffset + inputHeight);

                                if (spaceBelow > suggestionsHeight) {
                                    suggestions.css("top", inputOffset + inputHeight);
                                    suggestions.css("bottom", "auto");
                                } else {
                                    suggestions.css("top", "auto");
                                    suggestions.css("bottom", inputHeight + 10);
                                }
                            } else {
                                suggestions.hide();
                            }
                        }
                    });
                } else {
                    $("#suggestions").hide();
                }
            });

            $(document).on("click", "#suggestions li", function () {
                $("#searchBox").val($(this).text());
                $("#suggestions").hide();
            });

            $(document).click(function (event) {
                if (!$(event.target).closest("#searchBox").length) {
                    $("#suggestions").hide();
                }
            });
        });

    </script>
}